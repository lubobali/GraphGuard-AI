# Data — several GB, never in git.
# The frozen split is the exception: it is small, and it is the record every
# result is measured against, so it must be tracked and checksummed.
/data/*
!/data/splits/
!/data/splits/*.json
!/data/splits/*.sha256
*.csv
*.parquet
*.zip

# Credentials
kaggle.json
.env
.env.*
*.pem
credentials

# Model artifacts live in S3, not here
/models/
*.pt
*.pkl
*.joblib

# Tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
mlruns/
.ipynb_checkpoints/
.DS_Store

# Forgejo runner state — registration secret lives here
runner/

# Project-local toolchain (uv + Python), rebuilt by scripts/bootstrap.sh
.tools/

# Credentials — never in git
.secrets/

# Lakehouse warehouse files (Iceberg/Parquet). Rebuilt by `just lakehouse-build`.
/lakehouse/

# marimo saves cell outputs (real query results) next to notebooks. Never commit them.
__marimo__/

# Security audits and hardening plans: a map of the box's weak spots. The GitHub
# repo is public, so they never go to git (a public summary only after fixes).
/private/
/kafka-data/
