# Data — several GB, never in git.
# The frozen split is the exception: it is small, and it is the record every
# result is measured against, so it must be tracked and checksummed.
/data/*
!/data/splits/
!/data/splits/*.json
!/data/splits/*.sha256
*.csv
*.parquet
*.zip

# Credentials
kaggle.json
.env
.env.*
*.pem
credentials

# Model artifacts live in S3, not here
models/
*.pt
*.pkl
*.joblib

# Tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
mlruns/
.ipynb_checkpoints/
.DS_Store

# Forgejo runner state — registration secret lives here
runner/

# Project-local toolchain (uv + Python), rebuilt by scripts/bootstrap.sh
.tools/

# Credentials — never in git
.secrets/
